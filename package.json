{
  "name": "sailvis",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "clean": "tsc --build --clean",
    "build-debug": "vite build --debug",
    "type-check": "vue-tsc --noEmit",
    "start": "pnpm run web",
    "electron": "electron-vite dev -- ",
    "web": "vite",
    "build-web": "vite build",
    "build-electron": "electron-vite build",
    "build:win": "pnpm run build-electron && electron-builder --win --config",
    "build:win32": "pnpm run build-electron && electron-builder --win --ia32 --config"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "papaparse": "^5.5.4",
    "pinia": "^3.0.4",
    "uplot": "^1.6.32",
    "uplot-vue": "^1.2.4",
    "vue": "^3.5.38",
    "vuetify": "^4.1.2"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tsconfig/node16": "^16.1.6",
    "@types/node": "^20.19.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "electron": "22.3.27",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "~6.0.3",
    "vite": "^7.3.5",
    "vue-tsc": "^3.3.5"
  }
}
